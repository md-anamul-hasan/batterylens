<Window x:Class="BatteryLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BatteryLens.ViewModels"
        xmlns:ctrl="clr-namespace:BatteryLens.Controls"
        xmlns:theme="clr-namespace:Mdah.Theming"
        mc:Ignorable="d"
        Title="BatteryLens"
        Icon="Assets/icon.ico"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="940"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource Font.UI}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="KvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBase}"
            BorderBrush="{DynamicResource SurfaceBorderStrong}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <ctrl:TitleBar Grid.Row="0"/>

            <Grid Grid.Row="1" x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── Navigation ───────── -->
                <Border Background="{DynamicResource SurfaceOverlay}" Padding="12,16,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Lightning}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Overview"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Checks"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=3}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Cpu}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="System"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=4}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Lab}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Simulator"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Shopping}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Buying guide"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <theme:ThemeToggleButton Margin="0,0,0,6"/>
                        <!-- Open source link -->
                        <Button Command="{Binding OpenRepositoryCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="Open the project on GitHub">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceInteractive}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccess}"/>
                                    <TextBlock Text="Free and open source" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AppVersion, StringFormat=v{0} · MIT · GitHub}" Style="{StaticResource Label}" Margin="15,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBorder}"/>

                <!-- ───────── Content ───────── -->
                <Grid Grid.Column="2" Background="{DynamicResource SurfaceBase}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Simulation notice -->
                    <Border Grid.Row="0" Background="{DynamicResource AccentForgeMuted}" BorderBrush="{DynamicResource AccentForge}" BorderThickness="0,0,0,1" Padding="32,9"
                            Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <TextBlock Text="Simulation mode: the values below are not from your hardware." Foreground="{DynamicResource AccentForge}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Content="Back to live hardware" Command="{Binding ResetToLiveHardwareCommand}" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">

                        <!-- ═════ OVERVIEW ═════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32"
                                      Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                            <StackPanel MaxWidth="980">
                                <Grid Margin="0,0,0,22">
                                    <StackPanel>
                                        <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0" Text="{Binding SystemInfo.ProcessorName}" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshHardwareCommand}" ToolTip="Re-read the hardware sensors" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Data="{StaticResource Svg.Refresh}" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Margin="0,0,7,0"/>
                                                <TextBlock Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportHtmlReportCommand}" ToolTip="Save a full diagnostic report to your Desktop">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Data="{StaticResource Svg.Document}" Fill="{DynamicResource TextInverse}" Stretch="Uniform" Margin="0,0,7,0"/>
                                                <TextBlock Text="Export report"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Verdict hero -->
                                <Border Style="{StaticResource Panel}" Padding="28" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Recommendation.Urgency, Converter={StaticResource UrgencyToBrushConverter}}"/>
                                                <TextBlock Text="{Binding Recommendation.Urgency}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Recommendation.Urgency, Converter={StaticResource UrgencyToBrushConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Recommendation.Headline}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Recommendation.Subtitle}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Recommendation.SummaryText}" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="32,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Recommendation.ConfidenceScore, StringFormat='{}{0}%'}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="confidence" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Three verdicts -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Power supply" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{Binding Recommendation.ChargerVerdict.ActionRecommendation}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" TextWrapping="Wrap"
                                                       Foreground="{Binding Recommendation.ChargerVerdict.StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Recommendation.ChargerVerdict.Reason}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Recommendation.ChargerVerdict.CostEstimate}" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Battery" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{Binding Recommendation.BatteryVerdict.ActionRecommendation}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" TextWrapping="Wrap"
                                                       Foreground="{Binding Recommendation.BatteryVerdict.StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Recommendation.BatteryVerdict.Reason}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Recommendation.BatteryVerdict.CostEstimate}" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Computer" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{Binding Recommendation.PcVerdict.ActionRecommendation}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,6" TextWrapping="Wrap"
                                                       Foreground="{Binding Recommendation.PcVerdict.StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Recommendation.PcVerdict.Reason}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Recommendation.PcVerdict.CostEstimate}" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Battery health (laptops / simulation) -->
                                <Border Style="{StaticResource Panel}" Visibility="{Binding HasPhysicalBattery, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="Battery health" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"
                                                       Text="{Binding Battery.HealthPercentage, StringFormat='{}{0:F0}% of original capacity'}"
                                                       Foreground="{Binding Battery.HealthPercentage, Converter={StaticResource HealthToBrushConverter}}"/>
                                        </Grid>
                                        <Border Height="12" CornerRadius="6" Background="{DynamicResource SurfaceSunken}" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Battery.HealthPercentage, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                                                    <ColumnDefinition Width="{Binding Battery.WearLevelPercentage, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Battery.HealthPercentage, Converter={StaticResource HealthToBrushConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <UniformGrid Columns="4" Margin="0,20,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Charge" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Battery.ChargePercentage, StringFormat='{}{0:F0}%'}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Cycles" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Battery.CycleCount}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Usable capacity" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Battery.FullChargeCapacityMwh, StringFormat='{}{0:N0} mWh'}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Original capacity" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Battery.DesignCapacityMwh, StringFormat='{}{0:N0} mWh'}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Desktop (no battery) -->
                                <Border Style="{StaticResource Panel}" Visibility="{Binding HasPhysicalBattery, Converter={StaticResource InvertedBoolToVisConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="This computer" Style="{StaticResource SectionTitle}"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Content="Try the simulator" Click="OnGoToSimulationLabClicked" Foreground="{DynamicResource AccentPrimary}" Cursor="Hand"/>
                                        </Grid>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Motherboard" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding SystemInfo.MotherboardProduct}" Style="{StaticResource StatValue}" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Processor" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding SystemInfo.ProcessorCores, StringFormat='{}{0} cores'}" Style="{StaticResource StatValue}" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Memory" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding SystemInfo.TotalPhysicalMemoryGb, StringFormat='{}{0:F0} GB'}" Style="{StaticResource StatValue}" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Power plan" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding SystemInfo.ActivePowerPlan}" Style="{StaticResource StatValue}" FontSize="16"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0"
                                                   Text="This PC runs on mains power, so there is no battery to wear out. If it shuts off unexpectedly, check the power supply or add a UPS."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════ CHECKS ═════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32"
                                      Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                            <StackPanel MaxWidth="980">
                                <TextBlock Text="Checks" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,22" Text="What BatteryLens verified on this computer, and how each item looks."/>
                                <Border Style="{StaticResource Panel}" Padding="8,6">
                                    <ItemsControl ItemsSource="{Binding Recommendation.Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusWarningMuted}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusErrorMuted}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Assessment}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════ BUYING GUIDE ═════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32"
                                      Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=2}">
                            <StackPanel MaxWidth="980">
                                <TextBlock Text="Buying guide" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,22" Text="Charger, battery or a new computer? Check before you spend."/>

                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Replace the charger ($25 – $50)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="The laptop does not charge, loses percentage while plugged in, or only charges when the cable is bent. If battery health is above 70%, the battery is not the problem. Make sure the new charger matches your laptop's wattage (65 W, 100 W or 140 W); a phone charger cannot power a laptop under load."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Replace the battery ($40 – $85)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="The laptop runs well on mains power but dies within one or two hours unplugged. Consider a new pack when health is below 65%, wear is above 35%, or the cycle count is past 500 – 800. Search for the exact battery model shown on the System page."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Desktop power problems" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Random reboots under load, clicking from the power supply or a PC that will not start usually point to a failing power supply, not a battery. If blackouts are common where you live, add a UPS (about $90 – $140 for 1000 VA)."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════ SYSTEM ═════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32"
                                      Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=3}">
                            <StackPanel MaxWidth="980">
                                <Grid Margin="0,0,0,22">
                                    <StackPanel>
                                        <TextBlock Text="System" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Hardware details read from Windows."/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Command="{Binding GenerateOfficialWindowsReportCommand}"
                                            ToolTip="Create and open the built-in Windows battery report" Content="Windows battery report"/>
                                </Grid>

                                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,24,18">
                                            <TextBlock Text="Computer" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}" Text="{Binding SystemInfo.ComputerName}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="Manufacturer and model" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}">
                                                <Run Text="{Binding SystemInfo.Manufacturer, Mode=OneWay}"/> <Run Text="{Binding SystemInfo.Model, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,18">
                                            <TextBlock Text="Motherboard" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}" Text="{Binding SystemInfo.MotherboardProduct}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="Processor" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}" Text="{Binding SystemInfo.ProcessorName}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,18">
                                            <TextBlock Text="Memory" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}">
                                                <Run Text="{Binding SystemInfo.TotalPhysicalMemoryGb, StringFormat='{}{0:F0} GB', Mode=OneWay}"/> · <Run Text="{Binding SystemInfo.ProcessorCores, StringFormat='{}{0} cores', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="Windows power plan" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}" Text="{Binding SystemInfo.ActivePowerPlan}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,0">
                                            <TextBlock Text="Power source" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}" Text="{Binding SystemInfo.PowerDeliverySource}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="BIOS" Style="{StaticResource Label}"/>
                                            <TextBlock Style="{StaticResource KvValue}">
                                                <Run Text="{Binding SystemInfo.BiosVersion, Mode=OneWay}"/> · <Run Text="{Binding SystemInfo.BiosDate, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- Live samples -->
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Live charge" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Label}" Text="{Binding LiveHistory.Count, StringFormat='{}{0} samples · every 3 s'}"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Muted}" Visibility="{Binding HasHistoryPoints, Converter={StaticResource InvertedBoolToVisConverter}}"
                                                   Text="Charge samples appear here on computers with a battery."/>

                                        <StackPanel Visibility="{Binding HasHistoryPoints, Converter={StaticResource BoolToVisConverter}}">
                                            <Border Height="84" Background="{DynamicResource SurfaceSunken}" CornerRadius="8" Padding="8,8,8,0">
                                                <ItemsControl ItemsSource="{Binding LiveHistory}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="8" Margin="1.5,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                                                    Height="{Binding Percentage, Converter={StaticResource PercentageToHeightConverter}, ConverterParameter=68}"
                                                                    ToolTip="{Binding Percentage, StringFormat='{}{0:F1}% charged'}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                                       Text="Green bars: charging. Blue bars: discharging."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════ SIMULATOR ═════ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,40"
                                      Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=4}">
                            <StackPanel MaxWidth="980">
                                <TextBlock Text="Simulator" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,22" Text="Load a sample battery, then adjust it to see how BatteryLens would advise. Nothing here touches your real hardware."/>

                                <Border Style="{StaticResource Panel}" Padding="8,6" Margin="0,0,0,16">
                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Load" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="72"
                                                                Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Style="{StaticResource Panel}" Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Adjust the battery" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="Original capacity" Style="{StaticResource Muted}"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SimDesignCapacity, StringFormat='{}{0:N0} mWh'}"/></Grid>
                                        <Slider Minimum="20000" Maximum="100000" Value="{Binding SimDesignCapacity, Mode=TwoWay}" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="Usable capacity" Style="{StaticResource Muted}"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SimFullChargeCapacity, StringFormat='{}{0:N0} mWh'}"/></Grid>
                                        <Slider Minimum="5000" Maximum="100000" Value="{Binding SimFullChargeCapacity, Mode=TwoWay}" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="Current charge" Style="{StaticResource Muted}"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SimCurrentCapacity, StringFormat='{}{0:N0} mWh'}"/></Grid>
                                        <Slider Minimum="0" Maximum="{Binding SimFullChargeCapacity}" Value="{Binding SimCurrentCapacity, Mode=TwoWay}" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="Charge cycles" Style="{StaticResource Muted}"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SimCycleCount}"/></Grid>
                                        <Slider Minimum="0" Maximum="1200" Value="{Binding SimCycleCount, Mode=TwoWay}" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,0,0,14"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="Power draw / charge rate" Style="{StaticResource Muted}"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SimRateWatts, StringFormat='{}{0:F1} W'}"/></Grid>
                                        <Slider Minimum="5" Maximum="80" Value="{Binding SimRateWatts, Mode=TwoWay}" Margin="0,0,0,18"/>

                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Plugged in" IsChecked="{Binding SimIsAcOnline, Mode=TwoWay}" Margin="0,0,28,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <CheckBox Content="Charging" IsChecked="{Binding SimIsCharging, Mode=TwoWay}" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Toast -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="720" CornerRadius="10" Padding="16,11"
                                Background="{DynamicResource SurfaceInteractive}" BorderBrush="{DynamicResource SurfaceBorderStrong}" BorderThickness="1"
                                Visibility="{Binding IsStatusBannerVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusInfo}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Success"><Setter Property="Fill" Value="{DynamicResource StatusSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource StatusWarning}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Error"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusBannerMessage}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissBannerCommand}" Content="✕" ToolTip="Dismiss" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

            <ctrl:StatusBar Grid.Row="2"/>
        </Grid>
    </Border>
</Window>
