<UserControl x:Class="BatteryLens.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">

    <Border Background="{DynamicResource SurfaceOverlay}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="0,0,8,8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource StatusSuccess}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource AccentForge}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Live"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                    <Setter Property="Text" Value="Simulation"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                       Text="{Binding AppVersion, StringFormat='{}BatteryLens v{0}'}"/>
        </Grid>
    </Border>
</UserControl>
