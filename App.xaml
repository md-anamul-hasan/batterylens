<Application x:Class="BatteryLens.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BatteryLens.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="Themes/Win11Controls.xaml"/>
                <ResourceDictionary Source="Themes/SvgIcons.xaml"/>
                <ResourceDictionary Source="Themes/BaseStyles.xaml"/>
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:HealthToBrushConverter x:Key="HealthToBrushConverter" />
            <converters:UrgencyToBrushConverter x:Key="UrgencyToBrushConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" Invert="True" />
            <converters:TimeSpanFormatConverter x:Key="TimeSpanConverter" />
            <converters:DoubleToStarGridLengthConverter x:Key="DoubleToStarGridLengthConverter" />
            <converters:IntToRadioBoolConverter x:Key="IntToRadioBool" />
            <converters:IntToVisibilityConverter x:Key="IntToVis" />
            <converters:PercentageToHeightConverter x:Key="PercentageToHeightConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
